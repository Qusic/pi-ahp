{
	"name": "pi-ahp",
	"version": "0.0.0",
	"description": "Agent Host Protocol server for Pi coding agent",
	"keywords": [
		"agent-host-protocol",
		"ahp",
		"agent-host",
		"pi",
		"pi-coding-agent",
		"coding-agent",
		"ai-agent",
		"agent",
		"ai",
		"llm",
		"cli",
		"json-rpc",
		"websocket",
		"vscode"
	],
	"homepage": "https://github.com/Qusic/pi-ahp#readme",
	"bugs": {
		"url": "https://github.com/Qusic/pi-ahp/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Qusic/pi-ahp.git"
	},
	"license": "MIT",
	"type": "module",
	"files": [
		"dist"
	],
	"bin": {
		"pi-ahp": "dist/bin/cli.js",
		"pi-ahp-tunnel": "dist/bin/tunnel.js"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"start": "node src/bin/cli.ts",
		"test": "node --test",
		"check": "tsc",
		"lint": "biome check",
		"format": "biome check --write",
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"release": "semantic-release",
		"prepack": "pnpm run build"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "0.84.4",
		"@earendil-works/pi-coding-agent": "0.84.4",
		"@microsoft/agent-host-protocol": "0.9.0",
		"chokidar": "^5.0.0",
		"mime": "^4.1.0",
		"node-pty": "^1.2.0-beta.15",
		"ws": "^8.21.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@types/node": "^24.13.3",
		"@types/ws": "^8.18.1",
		"ajv": "^8.20.0",
		"semantic-release": "^25.0.9",
		"typescript": "^7.0.2"
	}
}
